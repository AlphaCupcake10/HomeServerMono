# Secrets only. Non-secret settings live in config/config.yaml (per-machine: config/config.local.yaml).
NODE_ENV=development

# JWT (production requires >= 32 chars and no "change-me" placeholders)
JWT_SECRET=change-me-in-production
REFRESH_TOKEN_SECRET=change-me-in-production

# Super admin password (the email is auth.superAdminEmail in config.yaml)
SUPER_ADMIN_PASSWORD=change-me

# Must match the Minecraft container's RCON password (docker-compose.yml passes it through)
MINECRAFT_RCON_PASSWORD=change-me
