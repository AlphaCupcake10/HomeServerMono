NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/home_server_mono

# JWT (production requires >= 32 chars and no "change-me" placeholders)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me-in-production
REFRESH_TOKEN_EXPIRES_IN=7d

# Super admin: created/synced on every startup. Only this account can create users.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me

# Server
CORS_ORIGINS=http://localhost:3000
# Number of reverse-proxy hops in front of the API (0 = none)
TRUST_PROXY=0

# Include the underlying error (name, message, code) in 500/502/503 responses.
# Handy on a private network; set to false if the API is exposed publicly.
EXPOSE_ERROR_DETAILS=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Max failed login/refresh attempts per window
AUTH_RATE_LIMIT_MAX=10

# Minecraft
MINECRAFT_CONTAINER_NAME=minecraft-server
MINECRAFT_DATA_DIR=/srv/minecraft
MINECRAFT_RCON_PORT=25575
MINECRAFT_RCON_HOST=127.0.0.1
MINECRAFT_RCON_PASSWORD=change-me
